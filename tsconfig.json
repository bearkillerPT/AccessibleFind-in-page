{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "~/*": [
        "./src/*"
      ],
      "@@/*": [
        "./*"
      ],
      "~~/*": [
        "./*"
      ]
    }
  },
  "include": [
    ".wxt/wxt.d.ts",
    "src",
    "tests",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
