{
  "name": "accessible-find-in-page",
  "version": "2.0.0",
  "private": true,
  "description": "An accessibility-focused replacement for the browser's find-in-page (Ctrl+F), with customizable, high-visibility highlighting.",
  "author": "Gil Teixeira",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "wxt build --mode e2e && playwright test",
    "test:firefox": "wxt build -b firefox --mode e2e && vitest run --config vitest.firefox.config.ts",
    "postinstall": "wxt prepare",
    "icons": "node scripts/render-icons.mjs",
    "store-assets": "wxt build --mode e2e && STORE_ASSETS=store playwright test store-assets",
    "store-video": "wxt build --mode e2e && STORE_VIDEO=store playwright test store-video"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.56.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.1",
    "puppeteer-core": "^24.43.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
